#!/usr/bin/env bash
# agent-peer — message the other agent (Claude <-> Codex) working in the same
# repo, when both run in Herdr panes. No realms, tmux or inbox involved.
#
#   agent-peer "<message>"               send to the one peer in this repo
#   agent-peer --to <pane> "<message>"   send to a named pane (e.g. w8:p1)
#   agent-peer --list                    show agents in this repo
#
# Herdr is the source of truth for who is where: `herdr agent list` names each
# pane's agent kind, workspace and cwd, and `herdr agent prompt` submits text
# as that agent's next user turn (queued if it is mid-turn). Every message
# carries the sender's pane id so the reply can come straight back.
set -euo pipefail

HERDR="${AGENT_PEER_HERDR:-herdr}"

die() { echo "agent-peer: $*" >&2; exit "${2:-1}"; }

[ -n "${HERDR_PANE_ID:-}" ] || die "not inside a Herdr pane (HERDR_PANE_ID unset)" 3

# A repo is its git toplevel; outside git, the cwd itself.
repo_of() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$1"; }

agents=$("$HERDR" agent list) || die "herdr agent list failed" 3
rows=$(jq -r '.result.agents[] | [.pane_id, .agent, .workspace_id, .agent_status, .cwd] | @tsv' <<<"$agents")

self_row=$(awk -F'\t' -v p="$HERDR_PANE_ID" '$1==p' <<<"$rows")
[ -n "$self_row" ] || die "this pane ($HERDR_PANE_ID) is not a detected agent" 3
IFS=$'\t' read -r _ self_kind self_ws _ self_cwd <<<"$self_row"
self_repo=$(repo_of "$self_cwd")

# Every other agent pane whose repo matches ours.
peers=""
while IFS=$'\t' read -r pane kind ws status cwd; do
  [ "$pane" = "$HERDR_PANE_ID" ] && continue
  [ "$(repo_of "$cwd")" = "$self_repo" ] || continue
  peers+="$pane"$'\t'"$kind"$'\t'"$ws"$'\t'"$status"$'\t'"$cwd"$'\n'
done <<<"$rows"

show() { printf '%s' "$1" | awk -F'\t' '{printf "  %-8s %-7s %-10s %s\n", $1, $2, $4, $5}' >&2; }

if [ "${1:-}" = "--list" ]; then
  echo "repo: $self_repo  (you: $HERDR_PANE_ID $self_kind)"
  printf '%s' "$peers" | awk -F'\t' '{printf "  %-8s %-7s %-10s %s\n", $1, $2, $4, $5}'
  exit 0
fi

target=""
if [ "${1:-}" = "--to" ]; then
  [ $# -ge 3 ] || die "usage: agent-peer --to <pane> \"<message>\"" 2
  target="$2"; shift 2
fi
[ $# -eq 1 ] || die "usage: agent-peer [--to <pane>] \"<message>\" | --list" 2
msg="$1"

if [ -z "$target" ]; then
  # Prefer the other kind of agent; among several, prefer this workspace.
  other=$(printf '%s' "$peers" | awk -F'\t' -v k="$self_kind" '$2!=k')
  [ -n "$other" ] || other="$peers"
  [ -n "$other" ] || die "no other agent pane in $self_repo" 5
  if [ "$(printf '%s' "$other" | grep -c .)" -gt 1 ]; then
    local_ws=$(printf '%s' "$other" | awk -F'\t' -v w="$self_ws" '$3==w')
    [ -n "$local_ws" ] && other="$local_ws"
  fi
  if [ "$(printf '%s' "$other" | grep -c .)" -gt 1 ]; then
    echo "agent-peer: more than one peer in $self_repo; pick one with --to:" >&2
    show "$other"
    exit 6
  fi
  target=$(cut -f1 <<<"$other")
fi

envelope="[agent-peer from:$self_kind pane:$HERDR_PANE_ID repo:$(basename "$self_repo")] $msg
(Reply only if a reply is needed: agent-peer --to $HERDR_PANE_ID \"<reply>\")"

"$HERDR" agent prompt "$target" "$envelope" >/dev/null \
  || die "herdr could not deliver to $target (blocked on a permission prompt, or gone)" 7
echo "agent-peer: delivered to $target"
